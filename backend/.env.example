DJANGO_SECRET_KEY=your-production-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tripurosundarobehera.me,www.tripurosundarobehera.me

# Database Configuration (PostgreSQL / SQLite)
# For local development with SQLite, leave DATABASE_URL blank or commented out.
# For production PostgreSQL:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=portfolio_db
DB_USER=portfolio_user
DB_PASSWORD=your_secure_password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://portfolio_user:your_secure_password@db:5432/portfolio_db

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com