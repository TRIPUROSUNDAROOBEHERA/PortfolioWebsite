# ==============================================================================
# Portfolio Stack - Environment Template
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tripurosundarobehera.me,www.tripurosundarobehera.me

# PostgreSQL Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=portfolio_db
DB_USER=portfolio_user
DB_PASSWORD=portfolio_secret_password
DB_HOST=db
DB_PORT=5432
DB_SSL_REQUIRE=False
DB_SSLMODE=disable
DATABASE_URL=postgres://portfolio_user:portfolio_secret_password@db:5432/portfolio_db

# CORS & CSRF Origins
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,https://tripurosundarobehera.me,https://www.tripurosundarobehera.me
CSRF_TRUSTED_ORIGINS=http://localhost,https://tripurosundarobehera.me,https://www.tripurosundarobehera.me

# Security Protocols
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Email Credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=